DS-exocortex-setup/

# Python virtual environment (developer-guide.md "Python-окружение")
.venv/

# Exocortex configuration (generated by setup-offline.sh, contains user paths)
.exocortex.env

# 3-way merge base file for QWEN.md
.qwen.md.base

# Transaction marker retained only while an update needs recovery (upstream #389).
# Живёт в WORKSPACE_DIR (родитель этого репо), не в SCRIPT_DIR — строка здесь для
# единообразия с шаблоном, реального эффекта на офлайн-установку не имеет.
.update-incomplete

# Снимок-эталон применённых правил (адаптация upstream 30efdb5 для офлайн-архитектуры,
# см. update.sh). Тоже в WORKSPACE_DIR, не в этом репо — строка для единообразия.
.qwen-rules.baseline/

# Qwen Code — персональные файлы (не входят в шаблон)
.qwen/settings.local.json
.qwen/checkpoint.md
.qwen/logs/
.qwen/QWEN.local.md

# Runtime state агента (consent-sentinel'ы WP Gate, пишет create-wp.sh) — issue #250
.qwen/state/

# Author-local downstream config for sync-communication-style.py (WP-388)
scripts/sync-communication-style.yaml

# Audit run logs (iwe-audit.sh) — issue #266, previously committed by accident
scripts/*.log

# Backup copies created by skill-promote.sh — local safety net, not for git
.backups/

# macOS metadata
.DS_Store
__pycache__/
*.pyc

# issue #348: params.yaml — пространство настройки пользователя, а не файл шаблона.
# В репозитории живёт только образец params.yaml.example; рабочий файл создаётся
# при установке и никогда не приезжает из git.
/params.yaml

# WP-529 Ф3: release-receipt.sh output — generated per-run in CI (uploaded as
# an artifact, not committed) and by any local dry-run of the script.
/release-receipt.json
