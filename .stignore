// Syncthing exclusions for IWE (Intellectual Work Environment)
// Prevents noise during Qwen Code sessions.
//
// Qwen Code writes continuously to .qwen/projects/ during sessions
// (conversation transcripts, task outputs) — syncing these is wasteful
// and triggers hundreds of change events per minute.

// Qwen Code session data (most noisy — kilobytes written every few seconds)
.qwen/projects/

// Qwen Code ephemeral state
.qwen/state/
.qwen/.cache/

// Rule-engine classifier logs (written every session + hourly)
logs/rule-engine/

// General logs directory
logs/*.log

// Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/

// macOS
.DS_Store
.Spotlight-V100
.Trashes

// Node
node_modules/

// Git objects (syncthing syncs .git/refs which can conflict)
.git/

// Temp/build
*.tmp
*.bak
dist/
build/
